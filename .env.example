# Environment configuration file
# Copy this to .env.local and update with your actual values

# Node environment
NODE_ENV=development

# Database configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hammerspace
DB_PORT=5432

# Application configuration
APP_PORT=3000

# Authentication configuration
# Generate secrets with: openssl rand -base64 32
AUTH_JWT_SECRET=your-jwt-secret-change-in-production
LOGIN_TOKEN_SECRET=your-login-token-secret-change-in-production

# WebAuthn configuration
PUBLIC_RP_ID=localhost
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost

# Asset upload storage
# UPLOAD_DIR is the filesystem path uploaded files are written to. In
# production this is the assets.hammerspace.co.uk nginx vhost's root
# (+ /uploaded); PUBLIC_ASSETS_URL is the public base URL those files are
# served from (nginx in prod, the local dev nginx's /uploaded/ location here).
UPLOAD_DIR=/var/www/assets.hammerspace.co.uk/uploaded
PUBLIC_ASSETS_URL=http://localhost/uploaded
