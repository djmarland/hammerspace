{
	"name": "hammerspace",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "NODE_ENV=production next build",
		"start": "next start",
		"start:standalone": "node .next/standalone/server.js",
		"prepare": "husky",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:seed": "node --import tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"admin:create-initial": "node --import tsx scripts/create-initial-admin.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@simplewebauthn/browser": "^14",
		"@simplewebauthn/server": "^14",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"marked": "^18",
		"marked-gfm-heading-id": "^4.1.4",
		"next": "^16.3.5",
		"prisma": "^7.9.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.5",
		"husky": "^9.1.7",
		"prettier": "3.9.6",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	},
	"browserslist": [
		"defaults ",
		"node >= 26"
	],
	"prettier": {
		"useTabs": true
	},
	"allowScripts": {
		"@prisma/engines@7.10.0": true,
		"esbuild@0.28.2": true,
		"prisma@7.10.0": true
	}
}
