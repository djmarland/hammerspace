{
	"name": "hammerspace",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:seed": "node --import tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"admin:create-initial": "node --import tsx scripts/create-initial-admin.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@simplewebauthn/browser": "^14",
		"@simplewebauthn/server": "^14",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.11.0",
		"marked": "^18",
		"marked-gfm-heading-id": "^4.1.4",
		"microlighter": "^2.1.0",
		"remark-gfm": "^4.0.1",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.2",
		"eslint": "^10",
		"husky": "^9.1.7",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prisma": "^7.9.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.0.16"
	},
	"browserslist": [
		"defaults ",
		"node >= 26"
	],
	"prettier": {
		"plugins": [
			"prettier-plugin-svelte"
		],
		"useTabs": true
	},
	"allowScripts": {
		"@prisma/engines@7.10.0": true,
		"esbuild@0.28.2": true,
		"prisma@7.10.0": true
	}
}
